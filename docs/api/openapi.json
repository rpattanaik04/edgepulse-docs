  },
  "components": {
    "schemas": {
      "Alert": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "examples": [
              "alt_5001"
            ]
          },
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "state": {
            "$ref": "#/components/schemas/AlertState"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "raised_at": {
            "type": "string",
            "format": "date-time",
            "title": "Raised At"
          },
          "acknowledged_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acknowledged At"
          },
          "acknowledged_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acknowledged By"
          }
        },
        "type": "object",
        "required": [
          "id",
          "device_id",
          "severity",
          "state",
          "message",
          "raised_at"
        ],
        "title": "Alert"
      },
      "AlertList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Alert"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "title": "AlertList"
      },
      "AlertState": {
        "type": "string",
        "enum": [
          "open",
          "acknowledged"
        ],
        "title": "AlertState"
      },
      "Device": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "examples": [
              "dev_1001"
            ]
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "site": {
            "type": "string",
            "title": "Site"
          },
          "protocol": {
            "$ref": "#/components/schemas/Protocol"
          },
          "status": {
            "$ref": "#/components/schemas/DeviceStatus"
          },
          "firmware": {
            "type": "string",
            "title": "Firmware"
          },
          "last_seen": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "site",
          "protocol",
          "status",
          "firmware",
          "created_at"
        ],
        "title": "Device"
      },
      "DeviceCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Name",
            "examples": [
              "Boiler Gateway 07"
            ]
          },
          "site": {
            "type": "string",
            "maxLength": 64,
            "minLength": 2,
            "title": "Site",
            "examples": [
              "Pune Plant"
            ]
          },
          "protocol": {
            "$ref": "#/components/schemas/Protocol",
            "default": "mqtt"
          },
          "firmware": {
            "type": "string",
            "title": "Firmware",
            "default": "1.0.0",
            "examples": [
              "1.2.4"
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "site"
        ],
        "title": "DeviceCreate"
      },
      "DeviceList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Device"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "DeviceList"
      },
      "DeviceStatus": {
        "type": "string",
        "enum": [
          "online",
          "offline",
          "maintenance"
        ],
        "title": "DeviceStatus"
      },
      "DeviceUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 3
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "site": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Site"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeviceStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "firmware": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Firmware"
          }
        },
        "type": "object",
        "title": "DeviceUpdate"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Stable, machine-readable error code."
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Readable explanation of the error."
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
