{
  "openapi": "3.1.0",
  "info": {
    "title": "EdgePulse API",
    "summary": "REST API for monitoring industrial edge devices.",
    "description": "EdgePulse is a **fictional** IIoT monitoring platform created for a documentation portfolio. This API is real and runnable, but all data is fictional and resets on restart.\n\nAuthenticate with `POST /api/v1/auth/token`, then send the token as `Authorization: Bearer <token>`.",
    "contact": {
      "name": "Rakesh Pattanaik",
      "url": "https://github.com/rpattanaik04"
    },
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "1.2.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check service health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/token": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get an access token",
        "operationId": "create_token_api_v1_auth_token_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Incorrect credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
