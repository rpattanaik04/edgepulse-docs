    "/api/v1/devices/{device_id}/telemetry": {
      "get": {
        "tags": [
          "Telemetry"
        ],
        "summary": "List telemetry readings",
        "operationId": "list_telemetry_api_v1_devices__device_id__telemetry_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Device Id"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Return readings at or after this UTC time.",
              "title": "Since"
            },
            "description": "Return readings at or after this UTC time."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Maximum readings, newest first.",
              "default": 10,
              "title": "Limit"
            },
            "description": "Maximum readings, newest first."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelemetryList"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Device not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Telemetry"
        ],
        "summary": "Submit a telemetry reading",
        "description": "Stores one reading and marks the device online. If vibration exceeds 5.0 mm/s, a critical alert is raised automatically.",
        "operationId": "submit_telemetry_api_v1_devices__device_id__telemetry_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
